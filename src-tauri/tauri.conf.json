{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicGlance",
  "version": "2.0.0",
  "identifier": "com.picglance.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "PicGlance",
      "width": 1100,
      "height": 740,
      "minWidth": 660,
      "minHeight": 480,
      "decorations": false,
      "transparent": true,
      "shadow": true,
      "dragDropEnabled": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../tools/gifsicle.exe": "tools/gifsicle.exe",
      "../tools/pngquant.exe": "tools/pngquant.exe",
      "../tools/README.md": "tools/README.md"
    }
  }
}
