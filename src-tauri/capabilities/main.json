{
  "identifier": "main",
  "windows": ["main"],
  "permissions": [
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-effects",
    "allow-windows-build",
    "allow-set-webview-memory-target",
    "allow-diagnostic-image",
    "allow-diagnostic-presented",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-viewer-open",
    "allow-viewer-directory",
    "allow-viewer-thumbnail",
    "allow-viewer-resource",
    "allow-viewer-cancel",
    "allow-viewer-copy",
    "allow-viewer-paste",
    "allow-viewer-choose",
    "allow-viewer-take-pending-open", "allow-viewer-rename",
    "allow-editor-open",
    "allow-editor-render",
    "allow-editor-save",
    "allow-editor-export",
    "allow-editor-close",
    "allow-compression-reserve", "allow-compression-run", "allow-compression-cancel",
    "allow-compression-read", "allow-compression-save",
    "allow-desktop-read", "allow-desktop-write", "allow-desktop-set-tray",
    "allow-desktop-associations", "allow-desktop-set-associations", "allow-desktop-default-apps",
    "allow-desktop-check-update", "allow-desktop-open-releases", "allow-desktop-open-license",
    "allow-desktop-close-from-host"
